<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Optica.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Marca de ejemplo versionada (sin la marca real): se copia a la salida y a la publicación como
         marca-ejemplo/, junto a los binarios; la usa la Api si no hay una marca instalada válida (ADR-003). -->
    <None Include="..\..\marca-ejemplo\**" LinkBase="marca-ejemplo" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optica.Application\Optica.Application.csproj" />
    <ProjectReference Include="..\Optica.Infrastructure\Optica.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lo exigen las herramientas de EF Core (dotnet ef) con la Api como proyecto de inicio. La aplicación no
         lo usa en tiempo de ejecución. PrivateAssets=all solo evita que pase a los proyectos que referencian a
         la Api: su DLL sigue copiándose a la salida de compilación y de publicación de este proyecto. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
